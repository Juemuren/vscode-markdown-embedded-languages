{
  "name": "markdown-embedded-languages",
  "displayName": "Markdown Embedded Languages",
  "description": "Forward Markdown fenced code language features to installed VS Code language extensions.",
  "version": "0.1.0",
  "private": true,
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:markdown"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Markdown Embedded Languages",
      "properties": {
        "markdownEmbeddedLanguages.languages": {
          "type": "object",
          "default": {},
          "description": "Map Markdown fence names to installed VS Code language IDs. Example: {\"tikz\": {\"language\": \"latex\"}}.",
          "additionalProperties": {
            "type": "object",
            "required": ["language"],
            "properties": {
              "language": {
                "type": "string",
                "description": "VS Code language ID used for completion, hover, and available diagnostics."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "npm run compile && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.9.0"
  }
}
