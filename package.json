{
  "name": "markdown-embedded-languages",
  "displayName": "Markdown Embedded Languages",
  "description": "Forward Markdown fenced code language features to installed VS Code language extensions.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[markdown]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "Markdown Embedded Languages",
      "properties": {
        "markdownEmbeddedLanguages.languages": {
          "type": "object",
          "default": {},
          "description": "Map Markdown fence names to installed VS Code language IDs. Example: {\"tikz\": {\"language\": \"latex\"}}.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "language"
            ],
            "properties": {
              "language": {
                "type": "string",
                "description": "VS Code language ID used for completion, hover, and available diagnostics."
              },
              "highlight": {
                "type": "object",
                "description": "Use a TextMate grammar file for live highlighting in Markdown fences.",
                "required": [
                  "grammar"
                ],
                "properties": {
                  "grammar": {
                    "type": "string",
                    "description": "Override the built-in grammar with a JSON or plist TextMate grammar path, relative to the workspace root or absolute."
                  },
                  "grammars": {
                    "type": "object",
                    "description": "Additional scope name to grammar file path mappings for external includes.",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "markdown-it": "^14.3.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
